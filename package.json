{
  "name": "rerousel",
  "version": "1.0.0",
  "description": "A tiny, dependency-free React carousel with native scrolling and interactive slides.",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs && node scripts/size.mjs",
    "build:sandbox": "npm run build && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "size": "node scripts/size.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:sandbox && npm run size",
    "prepublishOnly": "npm run check && npm audit --audit-level=low",
    "test:compat": "node scripts/compat.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aexol-studio/rerousel-react-carousel.git"
  },
  "bugs": {
    "url": "https://github.com/aexol-studio/rerousel-react-carousel/issues"
  },
  "homepage": "https://rerousel.netlify.app/",
  "author": "Aexol <aexol@aexol.com> (https://aexol.com)",
  "license": "MIT",
  "keywords": [
    "react",
    "carousel",
    "infinite-carousel",
    "lightweight",
    "slider",
    "typescript",
    "react19",
    "zero-dependency"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
